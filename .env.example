# Kopie als .env anlegen, dann docker compose up -d --build
# Die .env selbst gehört nicht ins Repo.

# Passwort für Postgres, vor dem ersten Start ändern
POSTGRES_PASSWORD=connect_password

# Wie lange eine Anmeldung gilt (Tage)
SESSION_DAYS=30

# 1 setzen, sobald die Seite über HTTPS läuft - dann geht das Cookie nur über TLS raus
COOKIE_SECURE=0

# Zusätzliche Origins für CORS (Komma-getrennt), wenn das Frontend woanders läuft
# CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,null
